# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# качени файлове (локален режим) и резултати от тестовете
/uploads
/e2e-output
!.env.example

