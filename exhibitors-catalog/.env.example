# =============================================================================
# Environment variables — копирайте този файл като .env и попълнете стойностите.
# НИКОГА не качвайте истинския .env в git.
# =============================================================================

# --- База данни (PostgreSQL 14+) ---------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/fair_catalog?schema=public"

# --- Автентикация на админ панела --------------------------------------------
# Случаен таен ключ за подписване на сесиите. Генериране:
#   openssl rand -base64 32
AUTH_SECRET=""
# true, когато сайтът е зад reverse proxy (Nginx, Caddy, Vercel и др.)
AUTH_TRUST_HOST=true

# --- Публичен адрес на сайта (за sitemap, canonical, Open Graph) -------------
SITE_URL="https://katalog.fair.bg"

# --- Първи администратор (използва се само от `npm run db:seed`) -------------
ADMIN_EMAIL="admin@fair.bg"
ADMIN_PASSWORD=""          # минимум 10 символа; сменете след първи вход

# --- Съхранение на качените лога ---------------------------------------------
# local = на диска на сървъра (VPS); s3 = S3-съвместимо хранилище (R2, S3, Spaces)
STORAGE_DRIVER=local
# Абсолютен път до папката за качени файлове (при STORAGE_DRIVER=local).
# ВАЖНО в продукция: папка ИЗВЪН проекта, която се архивира.
UPLOAD_DIR=/var/lib/fair-catalog/uploads

# При STORAGE_DRIVER=s3:
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_REGION=auto
# S3_BUCKET="fair-catalog"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_URL="https://cdn.katalog.fair.bg"   # публичен адрес на bucket-а
